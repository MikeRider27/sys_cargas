<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="emicrt" language="java" pageWidth="595" pageHeight="842" orientation="Portrait" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="25" bottomMargin="25" whenNoDataType="NoPages" whenResourceMissingType="Empty">
<parameter name="ID" class="java.lang.Integer"/>
<query language="sql"><![CDATA[SELECT k.nro || '/' || k.anho AS numero, k.fecha_emi,
       ex.nombres || coalesce(' ' || ex.apellidos, '') || ' - ' || ex.nro_doc AS exportador,
       im.nombres || coalesce(' ' || im.apellidos, '') || ' - ' || im.nro_doc AS importador,
       po.descrip AS pais_origen, pd.descrip AS pais_destino, a.descrip AS aduana, m.descrip AS moneda,
       k.id_ped, e.descrip AS estado, p.nombres || ' ' || p.apellidos AS personal,
       d.item, me.descrip AS mercaderia, d.cantidad, d.peso, d.volumen, d.valor, dm.abrev AS d_moneda
FROM emi_crt k
JOIN cliente ex ON ex.id_cliente = k.id_expo
JOIN cliente im ON im.id_cliente = k.id_impo
JOIN pais po ON po.id_pais = k.id_pais_o
JOIN pais pd ON pd.id_pais = k.id_pais_d
JOIN aduana a ON a.id_adu = k.id_adu
JOIN moneda m ON m.id_mon = k.id_mon
JOIN estado e ON e.id_est = k.id_est
JOIN personal p ON p.id_per = k.id_per
LEFT JOIN d_m_emi d ON d.id_crt = k.id_crt
LEFT JOIN mercaderia me ON me.id_merc = d.id_merc
LEFT JOIN moneda dm ON dm.id_mon = d.id_mon
WHERE k.id_crt = $P{ID}
ORDER BY d.item]]></query>
<field name="numero" class="java.lang.String"/>
<field name="fecha_emi" class="java.sql.Date"/>
<field name="exportador" class="java.lang.String"/>
<field name="importador" class="java.lang.String"/>
<field name="pais_origen" class="java.lang.String"/>
<field name="pais_destino" class="java.lang.String"/>
<field name="aduana" class="java.lang.String"/>
<field name="moneda" class="java.lang.String"/>
<field name="id_ped" class="java.lang.Integer"/>
<field name="estado" class="java.lang.String"/>
<field name="personal" class="java.lang.String"/>
<field name="item" class="java.lang.Integer"/>
<field name="mercaderia" class="java.lang.String"/>
<field name="cantidad" class="java.math.BigDecimal"/>
<field name="peso" class="java.math.BigDecimal"/>
<field name="volumen" class="java.math.BigDecimal"/>
<field name="valor" class="java.math.BigDecimal"/>
<field name="d_moneda" class="java.lang.String"/>
<variable name="T_peso" calculation="Sum" class="java.math.BigDecimal"><expression><![CDATA[$F{peso}]]></expression></variable>
<variable name="T_volumen" calculation="Sum" class="java.math.BigDecimal"><expression><![CDATA[$F{volumen}]]></expression></variable>
<variable name="T_valor" calculation="Sum" class="java.math.BigDecimal"><expression><![CDATA[$F{valor}]]></expression></variable>
