<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="recla" language="java" pageWidth="595" pageHeight="842" orientation="Portrait" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="25" bottomMargin="25" whenNoDataType="NoPages" whenResourceMissingType="Empty">
<parameter name="ID" class="java.lang.Integer"/>
<query language="sql"><![CDATA[SELECT rc.id_recla, rc.fecha, rc.descrip, rc.id_rped, rc.id_ped, c.nombres || coalesce(' ' || c.apellidos, '') AS cliente, c.telef,
       e.descrip AS estado, rc.fecha_c, rc.solucion, CASE WHEN rc.avisado THEN 'SÍ' ELSE 'NO' END AS avisado,
       p.nombres || ' ' || p.apellidos AS personal
FROM reclamos rc
JOIN r_pedido r ON r.id_rped = rc.id_rped
JOIN cliente c ON c.id_cliente = r.id_cliente
JOIN estado e ON e.id_est = rc.id_est
JOIN personal p ON p.id_per = rc.id_per
WHERE rc.id_recla = $P{ID}]]></query>
<field name="id_recla" class="java.lang.Integer"/>
<field name="fecha" class="java.sql.Date"/>
<field name="descrip" class="java.lang.String"/>
<field name="id_rped" class="java.lang.Integer"/>
<field name="id_ped" class="java.lang.Integer"/>
<field name="cliente" class="java.lang.String"/>
<field name="telef" class="java.lang.String"/>
<field name="estado" class="java.lang.String"/>
<field name="fecha_c" class="java.sql.Date"/>
<field name="solucion" class="java.lang.String"/>
<field name="avisado" class="java.lang.String"/>
<field name="personal" class="java.lang.String"/>
