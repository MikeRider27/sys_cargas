<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="asignacion" language="java" pageWidth="595" pageHeight="842" orientation="Portrait" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="25" bottomMargin="25" whenNoDataType="NoPages" whenResourceMissingType="Empty">
<parameter name="ID" class="java.lang.Integer"/>
<query language="sql"><![CDATA[SELECT a.id_asig, a.fecha_carg, a.descrip, a.id_ped || ' - ' || f.descrip AS pedido_flete, c.nombres || coalesce(' ' || c.apellidos, '') AS cliente,
       co.nombres || ' ' || co.apellidos || ' (' || co.nro_doc || ')' AS conductor,
       t.chapa_nr || ' - ' || mt.descrip || ' ' || mo.descrip || ' ' || mo.anho AS tracto,
       s.chapa_nro || ' - ' || ts.descrip || ' ' || to_char(s.cap_carg, 'FM999G999G990') || ' kg' AS semirremolque,
       a.id_viaj, e.descrip AS estado, p.nombres || ' ' || p.apellidos AS personal,
       sa.fecha_sal, sa.kilom_sal, sa.comb_sal, ll.fecha_lleg, ll.kilom_lleg, ll.comb_lleg,
       ll.kilom_lleg - sa.kilom_sal AS km_recorridos,
       d.item, ac.descrip AS accesorio, d.obs
FROM asignacion a
JOIN ped_flete f ON f.id_ped = a.id_ped
JOIN r_pedido r ON r.id_rped = f.id_rped
JOIN cliente c ON c.id_cliente = r.id_cliente
JOIN personal co ON co.id_per = a.id_cond
JOIN tracto t ON t.id_tc = a.id_tc
JOIN modelo_t mo ON mo.id_modt = t.id_modt
JOIN marca_t mt ON mt.id_mt = mo.id_mt
JOIN semirremolque s ON s.id_semi = a.id_semi
JOIN tipo_semi ts ON ts.id_tsem = s.id_tsem
JOIN estado e ON e.id_est = a.id_est
JOIN personal p ON p.id_per = a.id_per
LEFT JOIN r_salida sa ON sa.id_asig = a.id_asig AND sa.id_est <> 0
LEFT JOIN r_llegada ll ON ll.id_salid = sa.id_salid AND ll.id_est <> 0
LEFT JOIN d_acc d ON d.id_asig = a.id_asig
LEFT JOIN accesorios ac ON ac.id_acc = d.id_acc
WHERE a.id_asig = $P{ID}
ORDER BY d.item]]></query>
<field name="id_asig" class="java.lang.Integer"/>
<field name="fecha_carg" class="java.sql.Date"/>
<field name="descrip" class="java.lang.String"/>
<field name="pedido_flete" class="java.lang.String"/>
<field name="cliente" class="java.lang.String"/>
<field name="conductor" class="java.lang.String"/>
<field name="tracto" class="java.lang.String"/>
<field name="semirremolque" class="java.lang.String"/>
<field name="id_viaj" class="java.lang.Integer"/>
<field name="estado" class="java.lang.String"/>
<field name="personal" class="java.lang.String"/>
<field name="fecha_sal" class="java.sql.Date"/>
<field name="kilom_sal" class="java.math.BigDecimal"/>
<field name="comb_sal" class="java.math.BigDecimal"/>
<field name="fecha_lleg" class="java.sql.Date"/>
<field name="kilom_lleg" class="java.math.BigDecimal"/>
<field name="comb_lleg" class="java.math.BigDecimal"/>
<field name="km_recorridos" class="java.math.BigDecimal"/>
<field name="item" class="java.lang.Integer"/>
<field name="accesorio" class="java.lang.String"/>
<field name="obs" class="java.lang.String"/>
<title height="218"><element kind="staticText" x="0" y="0" width="300" height="20" fontSize="14.0" hTextAlign="Left" vTextAlign="Middle" bold="true"><box leftPadding="3" rightPadding="3"/><text><![CDATA[SYS CARGAS - Transporte de Cargas]]></text></element><element kind="textField" x="315" y="0" width="220" height="14" fontSize="8.0" hTextAlign="Right" vTextAlign="Middle" blankWhenNull="true"><box leftPadding="3" rightPadding="3"/><expression><![CDATA["Emitido: " + new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format(new java.util.Date())]]></expression></element><element kind="staticText" x="0" y="22" width="535" height="18" fontSize="12.0" hTextAlign="Left" vTextAlign="Middle" bold="true"><box leftPadding="3" rightPadding="3"/><text><![CDATA[Orden de carga - Asignación de equipo]]></text></element><element kind="line" x="0" y="44" width="535" height="1"><pen lineWidth="0.75" lineColor="#4A5A6A"/></element><element kind="staticText" x="0" y="50" width="105" height="16" fontSize="9.0" hTextAlign="Left" vTextAlign="Middle" bold="true"><box leftPadding="3" rightPadding="3"/><text><![CDATA[Asignación Nº:]]></text></element><element kind="textField" x="105" y="50" width="162" height="16" fontSize="9.0" hTextAlign="Left" vTextAlign="Middle" blankWhenNull="true"><box leftPadding="3" rightPadding="3"/><expression><![CDATA[$F{id_asig}]]></expression></element><element kind="staticText" x="267" y="50" width="105" height="16" fontSize="9.0" hTextAlign="Left" vTextAlign="Middle" bold="true"><box leftPadding="3" rightPadding="3"/><text><![CDATA[Fecha de carga:]]></text></element><element kind="textField" x="372" y="50" width="162" height="16" fontSize="9.0" hTextAlign="Left" vTextAlign="Middle" blankWhenNull="true" pattern="dd/MM/yyyy"><box leftPadding="3" rightPadding="3"/><expression><![CDATA[$F{fecha_carg}]]></expression></element><element kind="staticText" x="0" y="66" width="105" height="16" fontSize="9.0" hTextAlign="Left" vTextAlign="Middle" bold="true"><box leftPadd