<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="coti" language="java" pageWidth="595" pageHeight="842" orientation="Portrait" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="25" bottomMargin="25" whenNoDataType="NoPages" whenResourceMissingType="Empty">
<parameter name="ID" class="java.lang.Integer"/>
<query language="sql"><![CDATA[SELECT k.id_cot, k.fecha, c.nombres || coalesce(' ' || c.apellidos, '') AS cliente, td.descrip || ' ' || c.nro_doc AS documento,
       po.descrip || ' (tarifa ' || to_char(po.tarifa, 'FM999G999G990') || ')' AS origen,
       pd.descrip || ' (tarifa ' || to_char(pd.tarifa, 'FM999G999G990') || ')' AS destino,
       k.peso, k.volumen, k.costo, m.abrev AS moneda, e.descrip AS estado,
       p.nombres || ' ' || p.apellidos AS personal,
       d.item, me.descrip AS mercaderia, tm.descrip AS tipo_merc
FROM coti_flete k
JOIN cliente c ON c.id_cliente = k.id_cliente
JOIN tipo_doc td ON td.id_tdoc = c.id_tdoc
JOIN pais po ON po.id_pais = k.id_pais_o
JOIN pais pd ON pd.id_pais = k.id_pais_d
JOIN moneda m ON m.id_mon = k.id_mon
JOIN estado e ON e.id_est = k.id_est
JOIN personal p ON p.id_per = k.id_per
LEFT JOIN d_co_mer d ON d.id_cot = k.id_cot
LEFT JOIN mercaderia me ON me.id_merc = d.id_merc
LEFT JOIN tipo_merc tm ON tm.id_tm = me.id_tm
WHERE k.id_cot = $P{ID}
ORDER BY d.item]]></query>
<field name="id_cot" class="java.lang.Integer"/>
<field name="fecha" class="java.sql.Date"/>
<field name="cliente" class="java.lang.String"/>
<field name="documento" class="java.lang.String"/>
<field name="origen" class="java.lang.String"/>
<field name="destino" class="java.lang.String"/>
<field name="peso" class="java.math.BigDecimal"/>
<field name="volumen" class="java.math.BigDecimal"/>
<field name="costo" class="java.math.BigDecimal"/>
<field name="moneda" class="java.lang.String"/>
<field name="estado" class="java.lang.String"/>
<field name="personal" class="java.lang.String"/>
<field name="item" class="java.lang.Integer"/>
<field name="mercaderia" class="java.lang.String"/>
<field name="tipo_merc" class="java.lang.String"/>
