<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="rendicion" language="java" pageWidth="595" pageHeight="842" orientation="Portrait" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="25" bottomMargin="25" whenNoDataType="NoPages" whenResourceMissingType="Empty">
<parameter name="ID" class="java.lang.Integer"/>
<query language="sql"><![CDATA[SELECT r.id_rend, r.fecha, r.id_viat, v.fecha AS fecha_viat, p.nombres || ' ' || p.apellidos AS beneficiario,
       cj.descrip || ' (apertura ' || a.id_ap_cie || ')' AS caja, m.descrip AS moneda, v.id_viaj,
       e.descrip AS estado, r.total_asignado, r.total_rendido, r.diferencia, r.obs,
       k.fecha AS c_fecha, k.nro_comp, k.descrip AS c_descrip, k.monto
FROM rendiciones r
JOIN viatico v ON v.id_viat = r.id_viat
JOIN personal p ON p.id_per = v.id_per
JOIN aper_cierr_caja a ON a.id_ap_cie = v.id_ap_cie
JOIN caja cj ON cj.id_caj = a.id_caj
JOIN moneda m ON m.id_mon = a.id_mon
JOIN estado e ON e.id_est = r.id_est
LEFT JOIN comprobante k ON k.id_viat = v.id_viat AND k.id_est <> 0
WHERE r.id_rend = $P{ID}
ORDER BY k.fecha, k.id_comp]]></query>
<field name="id_rend" class="java.lang.Integer"/>
<field name="fecha" class="java.sql.Date"/>
<field name="id_viat" class="java.lang.Integer"/>
<field name="fecha_viat" class="java.sql.Date"/>
<field name="beneficiario" class="java.lang.String"/>
<field name="caja" class="java.lang.String"/>
<field name="moneda" class="java.lang.String"/>
<field name="id_viaj" class="java.lang.Integer"/>
<field name="estado" class="java.lang.String"/>
<field name="total_asignado" class="java.math.BigDecimal"/>
<field name="total_rendido" class="java.math.BigDecimal"/>
<field name="diferencia" class="java.math.BigDecimal"/>
<field name="obs" class="java.lang.String"/>
<field name="c_fecha" class="java.sql.Date"/>
<field name="nro_comp" class="java.lang.String"/>
<field name="c_descrip" class="java.lang.String"/>
<field name="monto" class="java.math.BigDecimal"/>
<title height="170"><element kind="staticText" x="0" y="0" width="300" height="20" fontSize="14.0" hTextAlign="Left" vTextAlign="Middle" bold="true"><box leftPadding="3" rightPadding="3"/><text><![CDATA[SYS CARGAS - Transporte de Cargas]]></text></element><element kind="textField" x="315" y="0" width="220" height="14" fontSize="8.0" hTextAlign="Right" vTextAlign="Middle" blankWhenNull="true"><box leftPadding="3" rightPadding="3"/><expression><![CDATA["Emitido: " + new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format(new java.util.Date())]]></expression></element><element kind="staticText" x="0" y="22" width="535" height="18" fontSize="12.0" hTextAlign="Left" vTextAlign="Middle" bold="true"><box leftPadding="3" rightPadding="3"/><text><![CDATA[Rendición de viático]]></text></element><element kind="line" x="0" y="44" width="535" height="1"><pen lineWidth="0.75" lineColor="#4A5A6A"/></element><element kind="staticText" x="0" y="50" width="105" height="16" fontSize="9.0" hTextAlign="Left" vTextAlign="Middle" bold="true"><box leftPadding="3" rightPadding="3"/><text><![CDATA[Rendición Nº:]]></text></element><element kind="textField" x="105" y="50" width="162" height="16" fontSize="9.0" hTextAlign="Left" vTextAlign="Middle" blankWhenNull="true"><box leftPadding="3" rightPadding="3"/><expression><![CDATA[$F{id_rend}]]></expression></element><element kind="staticText" x="267" y="50" width="105" height="16" fontSize="9.0" hTextAlign="Left" vTextAlign="Middle" bold="true"><box leftPadding="3" rightPadding="3"/><text><![CDATA[Fecha:]]></text></element><element kind="textField" x="372" y="50" width="162" height="16" fontSize="9.0" hTextAlign="Left" vTextAlign="Middle" blankWhenNull="true" pattern="dd/MM/yyyy"><box leftPadding="3" rightPadding="3"/><expression><![CDATA[$F{fecha}]]></expression></element><element kind="staticText" x="0" y="66" width="105" height="16" fontSize="9.0" hTextAlign="Left" vTextAlign="Middle" bold="true"><box leftPadding="3" rightPadding="3"/><text>