<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="ped_flete" language="java" pageWidth="595" pageHeight="842" orientation="Portrait" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="25" bottomMargin="25" whenNoDataType="NoPages" whenResourceMissingType="Empty">
<parameter name="ID" class="java.lang.Integer"/>
<query language="sql"><![CDATA[SELECT f.id_ped, f.fecha, f.descrip, f.id_rped, c.nombres || coalesce(' ' || c.apellidos, '') AS cliente,
       ds.nombres || ' ' || ds.apellidos || ' (' || ds.telef || ')' AS despachante,
       tc.descrip AS tipo_carga, e.descrip AS estado, p.nombres || ' ' || p.apellidos AS personal,
       d.item, me.descrip AS mercaderia, tm.descrip AS tipo_merc, d.cantidad
FROM ped_flete f
JOIN r_pedido r ON r.id_rped = f.id_rped
JOIN cliente c ON c.id_cliente = r.id_cliente
JOIN despachante ds ON ds.id_desp = f.id_desp
JOIN tipo_carg tc ON tc.id_tic = f.id_tic
JOIN estado e ON e.id_est = f.id_est
JOIN personal p ON p.id_per = f.id_per
LEFT JOIN d_merc d ON d.id_ped = f.id_ped
LEFT JOIN mercaderia me ON me.id_merc = d.id_merc
LEFT JOIN tipo_merc tm ON tm.id_tm = me.id_tm
WHERE f.id_ped = $P{ID}
ORDER BY d.item]]></query>
<field name="id_ped" class="java.lang.Integer"/>
<field name="fecha" class="java.sql.Date"/>
<field name="descrip" class="java.lang.String"/>
<field name="id_rped" class="java.lang.Integer"/>
<field name="cliente" class="java.lang.String"/>
<field name="despachante" class="java.lang.String"/>
<field name="tipo_carga" class="java.lang.String"/>
<field name="estado" class="java.lang.String"/>
<field name="personal" class="java.lang.String"/>
<field name="item" class="java.lang.Integer"/>
<field name="mercaderia" class="java.lang.String"/>
<field name="tipo_merc" class="java.lang.String"/>
<field name="cantidad" class="java.math.BigDecimal"/>
<variable name="T_cantidad" calculation="Sum" class="java.math.BigDecimal"><expression><![CDATA[$F{cantidad}]]></expression></variable>
