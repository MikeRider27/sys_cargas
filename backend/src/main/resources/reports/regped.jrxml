<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="regped" language="java" pageWidth="595" pageHeight="842" orientation="Portrait" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="25" bottomMargin="25" whenNoDataType="NoPages" whenResourceMissingType="Empty">
<parameter name="ID" class="java.lang.Integer"/>
<query language="sql"><![CDATA[SELECT r.id_rped, r.fecha, r.descrip, e.descrip AS estado, c.nombres || coalesce(' ' || c.apellidos, '') AS cliente,
       td.descrip || ' ' || c.nro_doc AS documento, c.telef, c.direcc,
       p.nombres || ' ' || p.apellidos AS personal,
       pf.id_ped, pf.fecha AS f_fecha, pf.descrip AS f_descrip, ef.descrip AS f_estado
FROM r_pedido r
JOIN estado e ON e.id_est = r.id_est
JOIN cliente c ON c.id_cliente = r.id_cliente
JOIN tipo_doc td ON td.id_tdoc = c.id_tdoc
JOIN personal p ON p.id_per = r.id_per
LEFT JOIN ped_flete pf ON pf.id_rped = r.id_rped AND pf.id_est <> 0
LEFT JOIN estado ef ON ef.id_est = pf.id_est
WHERE r.id_rped = $P{ID}
ORDER BY pf.id_ped]]></query>
<field name="id_rped" class="java.lang.Integer"/>
<field name="fecha" class="java.sql.Date"/>
<field name="descrip" class="java.lang.String"/>
<field name="estado" class="java.lang.String"/>
<field name="cliente" class="java.lang.String"/>
<field name="documento" class="java.lang.String"/>
<field name="telef" class="java.lang.String"/>
<field name="direcc" class="java.lang.String"/>
<field name="personal" class="java.lang.String"/>
<field name="id_ped" class="java.lang.Integer"/>
<field name="f_fecha" class="java.sql.Date"/>
<field name="f_descrip" class="java.lang.String"/>
<field name="f_estado" class="java.lang.String"/>
