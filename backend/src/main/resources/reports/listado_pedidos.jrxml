<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="listado_pedidos" language="java" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="782" leftMargin="30" rightMargin="30" topMargin="25" bottomMargin="25" whenNoDataType="NoDataSection" whenResourceMissingType="Empty">
<parameter name="DESDE" class="java.sql.Date"/>
<parameter name="HASTA" class="java.sql.Date"/>
<query language="sql"><![CDATA[SELECT r.id_rped, r.fecha, c.nombres || coalesce(' ' || c.apellidos, '') AS cliente, r.descrip, e.descrip AS estado,
       (SELECT count(*) FROM ped_flete f WHERE f.id_rped = r.id_rped AND f.id_est <> 0)::int AS fletes,
       p.nombres || ' ' || p.apellidos AS personal
FROM r_pedido r
JOIN cliente c ON c.id_cliente = r.id_cliente
JOIN estado e ON e.id_est = r.id_est
JOIN personal p ON p.id_per = r.id_per
WHERE r.fecha BETWEEN $P{DESDE} AND $P{HASTA}
ORDER BY r.fecha, r.id_rped]]></query>
<field name="id_rped" class="java.lang.Integer"/>
<field name="fecha" class="java.sql.Date"/>
<field name="cliente" class="java.lang.String"/>
<field name="descrip" class="java.lang.String"/>
<field name="estado" class="java.lang.String"/>
<field name="fletes" class="java.lang.Integer"/>
<field name="personal" class="java.lang.String"/>
<title height="70"><element kind="staticText" x="0" y="0" width="300" height="20" fontSize="14.0" hTextAlign="Left" vTextAlign="Middle" bold="true"><box leftPadding="3" rightPadding="3"/><text><![CDATA[SYS CARGAS - Transporte de Cargas]]></text></element><element kind="textField" x="562" y="0" width="220" height="14" fontSize="8.0" hTextAlign="Right" vTextAlign="Middle" blankWhenNull="true"><box leftPadding="3" rightPadding="3"/><expression><![CDATA["Emitido: " + new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format(new java.util.Date())]]></expression></element><element kind="staticText" x="0" y="22" width="782" height="18" fontSize="12.0" hTextAlign="Left" vTextAlign="Middle" bold="true"><box leftPadding="3" rightPadding="3"/><text><![CDATA[Listado de pedidos]]></text></element><element kind="textField" x="0" y="42" width="782" height="14" fontSize="9.0" hTextAlign="Left" vTextAlign="Middle" blankWhenNull="true"><box leftPadding="3" rightPadding="3"/><expression><![CDATA["Período: " + new java.text.SimpleDateFormat("dd/MM/yyyy").format($P{DESDE}) + " al " + new java.text.SimpleDateFormat("dd/MM/yyyy").format($P{HASTA})]]></expression></element><element kind="line" x="0" y="60" width="782" height="1"><pen lineWidth="0.75" lineColor="#4A5A6A"/></element></title>
<columnHeader height="18"><element kind="staticText" x="0" y="0" width="50" height="18" fontSize="9.0" hTextAlign="Right" vTextAlign="Middle" bold="true" mode="Opaque" backcolor="#E3E9F0"><box leftPadding="3" rightPadding="3"><bottomPen lineWidth="0.5" lineColor="#8A99AA"/></box><text><![CDATA[Nº]]></text></element><element kind="staticText" x="50" y="0" width="70" height="18" fontSize="9.0" hTextAlign="Center" vTextAlign="Middle" bold="true" mode="Opaque" backcolor="#E3E9F0"><box leftPadding="3" rightPadding="3"><bottomPen lineWidth="0.5" lineColor="#8A99AA"/></box><text><![CDATA[Fecha]]></text></element><element kind="staticText" x="120" y="0" width="180" height="18" fontSize="9.0" hTextAlign="Left" vTextAlign="Middle" bold="true" mode="Opaque" backcolor="#E3E9F0"><box leftPadding="3" rightPadding="3"><bottomPen lineWidth="0.5" lineColor="#8A99AA"/></box><text><![CDATA[Cliente]]></text></element><element kind="staticText" x="300" y="0" width="207" height="18" fontSize="9.0" hTextAlign="Left" vTextAlign="Middle" bold="true" mode="Opaque" backcolor="#E3E9F0"><box leftPadding="3" rightPadding="3"><bottomPen lineWidth="0.5" lineColor="#8A99AA"/></box><text><![CDATA[Descripción]]></text></element><element kind="staticText" x="507" y="0" width="85" height="18" fontSize="9.0" hTextAlign="Left" vTextAlign="Middle" bold="true" mode="Opaque" backcolor="#E3E9F0"><box leftPadding="3" rightPadding="3"><bottomPen lineWidth="0.5" lineColor="#8A99AA"/></box><text><![CDATA[Estado]]></text></element><element kind="staticText" x="592" y="0" width="50" height="18" fontSize="9.0" hTextAlign="Right" vTextAlign="Middle" bold="true" mode="Opaque" backcolor="#E3E9F0"><box leftPadding="3" rightPadding="3"><bottomPen lineWidth="0.5" lineColor="#8A99AA"/></box><text><![CDATA[Fletes]]></text></element><element kind="staticText" x="642" y="0" width="140" height="18" fontSize="9.0" hTextAlign="Left" vTextAlign="Middle" bold="true" mode="Opaque" backcolor="#E3E9F0"><box leftPadding="3" rightPadding="3"><bottomPen lineWidth="0.5" lineColor="#8A99AA"/></box><text><![CDATA[Registrado por]]></text></element></columnHeader>
<detail><band height="15"><element kind="textField" x="0" y="0" width="50" height="15" fontSize="9.0" hTextAlign="Right" vTextAlign="Middle" blankWhenNull="true"><box leftPadding="3" rightPadding="3"/><expression><![CDATA[$F{id_rped}]]></expression></element><element kind="textField" x="50" y="0" width="70" height="15" fontSize="9.0" hTextAlign="Center" vTextAlign="Middle" blankWhenNull="true" pattern="dd/MM/yyyy"><box leftPadding="3" rightPadding="3"/><expression><![CDATA[$F{fecha}]]></expression></element><element kind="textField" x="120" y="0" width="180" height="15" fontSize="9.0" hTextAlign="Left" vTextAlign="Middle" blankWhenNull="true" textAdjust="StretchHeight"><box leftPadding="3" rightPadding="3"/><expression><![CDATA[$F{cliente}]]></expression></element><element kind="textField" x="300" y="0" width="207" height="15" fontSize="9.0" hTextAlign="Left" vTextAlign="Middle" blankWhenNull="true" textAdjust="StretchHeight"><box leftPadding="3" rightPadding="3"/><expression><![CDATA[$F{descrip}]]></expression></element><element kind="textField" x="507" y="0" width="85" height="15" fontSize="9.0" hTextAlign="Left" vTextAlign="Middle" blankWhenNull="true" textAdjust="StretchHeight"><box leftPadding="3" rightPadding="3"/><expression><![CDATA[$F{estado}]]></expression></element><element kind="textField" x="592" y="0" width="50" height="15" fontSize="9.0" hTextAlign="Right" vTextAlign="Middle" blankWhenNull="true"><box leftPadding="3" rightPadding="3"/><expression><![CDATA[$F{fletes}]]></expression></element><element kind="textField" x="642" y="0" width="140" height="15" fontSize="9.0" hTextAlign="Left" vTextAlign="Middle" blankWhenNull="true" textAdjust="StretchHeight"><box leftPadding="3" rightPadding="3"/><expression><![CDATA[$F{personal}]]></expression></element></band></detail>
