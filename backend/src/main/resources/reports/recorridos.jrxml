rightPadding="3"><bottomPen lineWidth="0.5" lineColor="#8A99AA"/></box><text><![CDATA[Km llegada]]></text></element><element kind="staticText" x="607" y="0" width="90" height="18" fontSize="9.0" hTextAlign="Right" vTextAlign="Middle" bold="true" mode="Opaque" backcolor="#E3E9F0"><box leftPadding="3" rightPadding="3"><bottomPen lineWidth="0.5" lineColor="#8A99AA"/></box><text><![CDATA[Km recorridos]]></text></element><element kind="staticText" x="697" y="0" width="85" height="18" fontSize="9.0" hTextAlign="Right" vTextAlign="Middle" bold="true" mode="Opaque" backcolor="#E3E9F0"><box leftPadding="3" rightPadding="3"><bottomPen lineWidth="0.5" lineColor="#8A99AA"/></box><text><![CDATA[Consumo (l)]]></text></element></columnHeader>
