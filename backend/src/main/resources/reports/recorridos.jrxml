<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="recorridos" language="java" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="782" leftMargin="30" rightMargin="30" topMargin="25" bottomMargin="25" whenNoDataType="NoDataSection" whenResourceMissingType="Empty">
<parameter name="DESDE" class="java.sql.Date"/>
<parameter name="HASTA" class="java.sql.Date"/>
<query language="sql"><![CDATA[SELECT t.chapa_nr AS tracto, a.id_asig, co.nombres || ' ' || co.apellidos AS conductor,
       sa.fecha_sal, ll.fecha_lleg, sa.kilom_sal, ll.kilom_lleg, ll.kilom_lleg - sa.kilom_sal AS km,
       sa.comb_sal - ll.comb_lleg AS consumo
FROM r_llegada ll
JOIN r_salida sa ON sa.id_salid = ll.id_salid
JOIN asignacion a ON a.id_asig = sa.id_asig
JOIN tracto t ON t.id_tc = a.id_tc
JOIN personal co ON co.id_per = a.id_cond
WHERE ll.id_est <> 0 AND sa.id_est <> 0 AND ll.fecha_lleg BETWEEN $P{DESDE} AND $P{HASTA}
ORDER BY t.chapa_nr, ll.fecha_lleg]]></query>
<field name="tracto" class="java.lang.String"/>
<field name="id_asig" class="java.lang.Integer"/>
<field name="conductor" class="java.lang.String"/>
<field name="fecha_sal" class="java.sql.Date"/>
<field name="fecha_lleg" class="java.sql.Date"/>
<field name="kilom_sal" class="java.math.BigDecimal"/>
<field name="kilom_lleg" class="java.math.BigDecimal"/>
<field name="km" class="java.math.BigDecimal"/>
<field name="consumo" class="java.math.BigDecimal"/>
<variable name="T_km" calculation="Sum" class="java.math.BigDecimal"><expression><![CDATA[$F{km}]]></expression></variable>
<title height="70"><element kind="staticText" x="0" y="0" width="300" height="20" fontSize="14.0" hTextAlign="Left" vTextAlign="Middle" bold="true"><box leftPadding="3" rightPadding="3"/><text><![CDATA[SYS CARGAS - Transporte de Cargas]]></text></element><element kind="textField" x="562" y="0" width="220" height="14" fontSize="8.0" hTextAlign="Right" vTextAlign="Middle" blankWhenNull="true"><box leftPadding="3" rightPadding="3"/><expression><![CDATA["Emitido: " + new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format(new java.util.Date())]]></expression></element><element kind="staticText" x="0" y="22" width="782" height="18" fontSize="12.0" hTextAlign="Left" vTextAlign="Middle" bold="true"><box leftPadding="3" rightPadding="3"/><text><![CDATA[Recorridos y consumo por tracto]]></text></element><element kind="textField" x="0" y="42" width="782" height="14" fontSize="9.0" hTextAlign="Left" vTextAlign="Middle" blankWhenNull="true"><box leftPadding="3" rightPadding="3"/><expression><![CDATA["Período: " + new java.text.SimpleDateFormat("dd/MM/yyyy").format($P{DESDE}) + " al " + new java.text.SimpleDateFormat("dd/MM/yyyy").format($P{HASTA})]]></expression></element><element kind="line" x="0" y="60" width="782" height="1"><pen lineWidth="0.75" lineColor="#4A5A6A"/></element></title>
