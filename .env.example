# Copiar a .env y completar. NO versionar el .env real.
DB_PASSWORD=cambie-esta-clave
# Minimo 32 caracteres aleatorios, p.ej.: openssl rand -base64 48
JWT_SECRET=
# Usuario administrador creado en el primer arranque (min. 8 caracteres, letras y numeros).
# Si se deja vacio se genera una clave temporal que aparece en el log del backend.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
APP_PORT=8097
TZ=America/Asuncion
